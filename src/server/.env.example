NODE_ENV=production
PORT=3333

# MySQL/MariaDB connection (e.g. AWS RDS).
# For RDS over SSL, append the CA bundle path as a `sslcert` query param — the app
# reads this param directly (NODE_EXTRA_CA_CERTS is NOT used by the code):
#   mysql://user:password@your-rds-endpoint.amazonaws.com:3306/biblioteca?sslcert=./.certs/global-bundle.pem
DATABASE_URL="mysql://user:password@your-rds-endpoint.amazonaws.com:3306/biblioteca?sslcert=./.certs/global-bundle.pem"

# Auth (REQUIRED) — login and protected routes throw without a JWT secret.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS (optional) — comma-separated allowed origins.
# Defaults to the localhost dev origins when unset. Set this in production to the
# origin(s) the web/mobile clients are served from, e.g.:
# CORS_ORIGINS="http://localhost:3000,http://your-web-host"
